# Copy to backend/.env and fill in. Never commit .env.
NESSIE_API_KEY=
# e.g. postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=
# Written by seed into cache/ids.json; set here only to override.
CUSTOMER_ID=
NVIDIA_API_KEY=
ASR_FUNCTION_ID=
TTS_FUNCTION_ID=
NMT_FUNCTION_ID=
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.5-flash
# Nessie v2 (key from v2.nessieisreal.com/account, starts with nsk_)
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Optional: separate keys per speech model (else NVIDIA_API_KEY)
ASR_API_KEY=
TTS_API_KEY=

# Phase 0: app accounts, sessions and user-scoped bank data
AHEAD_ENV=development
AHEAD_DEMO_MODE=false
# PostgreSQL recommended for deployment; leave blank for local SQLite.
APP_DATABASE_URL=
APP_DB_PATH=data/ahead.sqlite3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AHEAD_ENCRYPTION_KEY=
PLAID_ENV=sandbox
# Staging without Plaid credentials: explicitly set false and keep bank tests pending.
# Production launches with bank linking enabled require real provider credentials.
AHEAD_BANK_CONNECTIONS_ENABLED=true
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional publicly reachable HTTPS endpoint, e.g. https://your-domain.example/bank/webhook
# Without this, run the worker to periodically poll for updates.
PLAID_WEBHOOK_URL=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Milestone 4: operator-only sync status; set to a random >=32-char secret in deployment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
AHEAD_OPS_TOKEN=

# Milestone 3: identity delivery and production origin
PUBLIC_APP_URL=http://localhost:3000
# Required in production; leave unset locally to write .eml files in backend/data/mail-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Ahead <noreply@example.com>
# Optional local-only outbox path
DEV_MAIL_OUTBOX=

# Milestone 5: production configuration is checked with:
#   cd backend && python production_check.py
# The production deployment must also configure AHEAD_API_INTERNAL_URL on
# the separately hosted Next.js frontend, pointing to the trusted backend.
# Your APP_DATABASE_URL and encryption key must survive every deployment.
# User privacy actions are available at /auth/privacy/export and /auth/privacy/delete.
